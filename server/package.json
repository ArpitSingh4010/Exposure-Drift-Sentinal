{
  "name": "eds-server",
  "version": "0.1.0",
  "private": true,
  "mongodbMemoryServer": {
    "version": "7.0.14"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "cross-env MONGOMS_VERSION=7.0.14 MONGOMS_PREFER_GLOBAL_PATH=0 tsx src/dev-mongo.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/index.ts",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "cross-env": "^10.1.0",
    "date-fns": "^3.6.0",
    "express": "^4.21.2",
    "fuzzball": "^2.1.2",
    "js-yaml": "^4.1.0",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "seedrandom": "^3.0.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.6",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^9.18.0",
    "mongodb-memory-server": "~7.6.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
